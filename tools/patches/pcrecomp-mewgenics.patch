diff --git a/tools/lift/generate64.py b/tools/lift/generate64.py
index ee47c89..d70fe49 100644
--- a/tools/lift/generate64.py
+++ b/tools/lift/generate64.py
@@ -230,9 +230,18 @@ def plausible_code(read_va, va):
         from capstone import Cs, CS_ARCH_X86, CS_MODE_64
         _CODE_MD = Cs(CS_ARCH_X86, CS_MODE_64)
     try:
-        code = read_va(va, 16)
+        code = read_va(va, 48)
     except Exception:
         return False
+    # Mewgenics: 16 bytes cut a leaf function whose first two loads are 7 bytes each
+    # (0x1408E3C20); and an entry right after int3/ret padding is a function start.
+    try:
+        prev = read_va(va - 1, 1)[0]
+    except Exception:
+        prev = None
+    first = next(iter(_CODE_MD.disasm(code, va)), None)
+    if prev in (0xCC, 0xC3) and first is not None and first.mnemonic != 'int3' and code[:2] != b'\x00\x00':
+        return True
     n = 0
     for ins in _CODE_MD.disasm(code, va):
         if ins.mnemonic in ('int3', 'in', 'out', 'hlt', 'iretd', 'iretq',
@@ -241,6 +250,16 @@ def plausible_code(read_va, va):
         n += 1
         if n >= 3:
             return True
+        # Mewgenics: atexit destructor thunks are "lea rcx, [obj]; jmp dtor" followed by
+        # int3 padding (0x140E3CF00), and empty ones are a lone "ret 0" (0x140E3E618),
+        # right after the previous thunk's jmp. A one- or two-instruction sequence ending
+        # in an unconditional jmp/ret right before padding or a 16-byte boundary is a
+        # complete function.
+        if n <= 2 and ins.mnemonic in ('jmp', 'ret'):
+            end = ins.address + ins.size
+            nxt = code[end - va] if end - va < len(code) else None
+            if nxt == 0xCC or end % 16 == 0:
+                return True
     return False
 
 
